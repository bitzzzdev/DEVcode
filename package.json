{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "devcode",
  "description": "AI-powered development tool",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/cli src/index.ts",
    "lint": "oxlint && ast-grep scan --rule script/ast-grep/dialog-size.yml packages && bun script/sdk-docs.ts",
    "lint:effect-patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/util/src packages/core/src packages/server/src packages/protocol/src packages/cli/src",
    "lint:effect-simplifications": "ast-grep scan -c script/ast-grep/effect-simplifications/sgconfig.yml --off=unused-suppression packages",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "test:effect-simplification-rules": "ast-grep test -c script/ast-grep/effect-simplifications/sgconfig.yml",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "typecheck:profile": "bun script/profile-typecheck.ts",
    "typecheck:profile:packages": "bun script/profile-typecheck-packages.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/plugins/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.1.0",
      "@effect/platform-node": "4.1.0",
      "@effect/platform-node-shared": "4.1.0",
      "@effect/sql-sqlite-bun": "4.1.0",
      "@effect/sql-sqlite-node": "4.1.0",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.3",
      "@hona/strobe": "0.42.0",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@opentui/core": "0.8.4",
      "@opentui/keymap": "0.8.4",
      "@opentui/solid": "0.8.4",
      "@standard-schema/spec": "1.1.0",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "diff": "8.0.4",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.1.0",
      "fast-check": "4.9.0",
      "cross-spawn": "7.0.6",
      "hono": "4.13.13",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "semver": "7.7.4",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "zod": "4.6.7",
      "remeda": "2.26.0",
      "shiki": "4.4.3",
      "string-width": "7.2.0",
      "vite": "7.3.7",
      "solid-js": "1.9.17",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@hona/strobe": "catalog:",
    "@devcode/client": "workspace:*",
    "@oxlint/plugins": "1.93.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/react": "19.2.17",
    "@typescript/native": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@devcode/plugin": "workspace:*",
    "@devcode/script": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bitzzdev/DEVcode.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "open": "11.0.4",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.17": "patches/solid-js@1.9.17.patch",
    "@ai-sdk/mistral@3.0.51": "patches/@ai-sdk%2Fmistral@3.0.51.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.1": "patches/pacote@21.5.1.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@ff-labs/fff-bun@0.10.5": "patches/@ff-labs%2Ffff-bun@0.10.5.patch",
    "vite@8.2.4": "patches/vite@8.2.4.patch",
    "@modelcontextprotocol/client@2.4.0": "patches/@modelcontextprotocol%2Fclient@2.4.0.patch"
  }
}
