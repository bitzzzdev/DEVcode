{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schema/src/public/.oxlintrc.schema.json",
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "Reflect",
        "message": "Use typed property access or direct invocation. Suppress this rule only for genuine reflection."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/ai/src/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Reflect",
            "message": "Use typed property access or direct invocation. Suppress this rule only for genuine reflection."
          },
          {
            "name": "fetch",
            "message": "Send HTTP through RequestExecutor, which applies executor-wide and scoped middleware (HTTP hooks). A request sent any other way skips them."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/http",
                "importNames": [
                  "HttpClient",
                  "FetchHttpClient"
                ],
                "message": "Send HTTP through RequestExecutor, which applies executor-wide and scoped middleware (HTTP hooks). Only route/executor.ts holds the HTTP client."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/ai/src/route/executor.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "packages/plugin/src/gui/**",
        "packages/ui/**"
      ],
      "rules": {
        "oxc/no-accumulating-spread": "warn"
      }
    },
    {
      "files": [
        "packages/plugin/src/gui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/",
                "message": "The GUI SDK never imports app internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/codemode/src/interpreter/**",
        "packages/codemode/src/stdlib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "allowTypeImports": true,
                "message": "The evaluator and built-ins are plain generators driven by the job queue in runner.ts. Start host work with runner.host or block on it with runner.blocking; only runner.ts, execute.ts, and extensions.ts run Effects."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/codemode/src/interpreter/runner.ts",
        "packages/codemode/src/interpreter/execute.ts",
        "packages/codemode/src/interpreter/extensions.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.build",
    "**/.sst",
    "**/*.d.ts",
    "**/sdk.gen.ts",
    "packages/plugins/figma/skills/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".devcode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ]
}
