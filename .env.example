# DEVcode environment variables

# GitLab releases page. `devcode upgrade` reports here
# instead of calling any update service; set DEVCODE_DISABLE_AUTOUPDATE=1
# to skip update checks entirely.
# DEVCODE_UPDATE_CHANNEL=

# Path to the third-party pty binary shipped by @opencode/pty. Defaults to
# the one bundled inside the DEVcode binary cache directory.
# DEVCODE_PTY_BIN=

# Configuration directory. Defaults to XDG_CONFIG_HOME/devcode, or
# ~/.config/devcode when XDG is unset.
# DEVCODE_CONFIG_DIR=

# Local database path. Defaults to <config dir>/devcode.db.
# DEVCODE_DB=

# Mode. Released binaries run `dev` channel; CI sets `local`/`preview`.
# DEVCODE_CHANNEL=

# Build-time only (not needed at runtime):
# DEVCODE_TARGET=linux-x64           # CircleCI build target
# DEVCODE_RELEASE_NOTES=             # release notes embedded at build time
